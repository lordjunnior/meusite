# Copy this file to .env and replace the placeholders with your project's values.
# Use only a Supabase publishable (anon) key in VITE_* variables; never put service_role or secret keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
